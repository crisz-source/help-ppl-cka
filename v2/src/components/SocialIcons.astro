---
// Ícones sociais padrão + atalho para o layout 1 (o mesmo conteúdo, em MkDocs).
import Default from '@astrojs/starlight/components/SocialIcons.astro';
---

<a class="layout-classico" href="/help-ppl-cka/" title="Mesmo conteúdo no layout clássico">layout clássico</a>
<Default />

<style>
	.layout-classico {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
		text-decoration: none;
		white-space: nowrap;
	}
	.layout-classico:hover {
		color: var(--sl-color-white);
	}
	@media (max-width: 50rem) {
		.layout-classico {
			display: none;
		}
	}
</style>
